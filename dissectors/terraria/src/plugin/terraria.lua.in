-- Generated by `make install`. Wireshark scans its plugin folder recursively and runs every
-- .lua file it finds, so only this loader lives there; the dissector's modules stay in
-- MODULE_DIR and are reached through package.path.
local module_dir = [==[@MODULE_DIR@]==]

package.path = module_dir .. "/?.lua;" .. module_dir .. "/?/init.lua;" .. package.path
dofile(module_dir .. "/terraria.lua")
